{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,

    "noEmit": true,
    "erasableSyntaxOnly": true,

    "rootDir": "src",
    // "outDir": "dist",

    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
