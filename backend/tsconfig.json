{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,

    "rootDir": ".",

    "noEmit": true,
    "erasableSyntaxOnly": true,

    "allowImportingTsExtensions": true,

    "types": ["node"],

    "paths": { "@todo/shared": ["../shared/src/index.ts"] }
  },
  "include": ["src/**/*", "generated/*"],
  "exclude": ["node_modules"],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
